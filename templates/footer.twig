{% if minimal_page %}
<footer id="footer" class="site-footer marlin-footer site-footer--minimal-page">
    <div class="container d-flex flex-column flex-lg-row align-items-center">
        <img
            class="footer-logo"
            src="{{ fn('get_stylesheet_directory_uri') }}/img/logo-white.svg"
            alt="Greenpeace"
            data-ga-category="Footer"
            data-ga-action="Greenpeace Logo"
            data-ga-label="{{ page_category }}">
        <span class="footer-copyright" role="text">
            {{ 'creative-commons'|svgicon }}
            {{ copyright_text_line2|e('wp_kses_post')|raw }} {{"now"|date('Y')}}
        </span>
        {% include 'footer_social_media.twig' %}
    </div>
</footer>
{% else %}
<footer id="footer" class="site-footer marlin-footer site-footer--{{ nav_type }}">
    {% if nav_type != 'minimal' %}
    <div id="footer-logo" class="footer-logo">
        {% include 'footer_logo.twig' %}
    </div>
    {% endif %}
    <div class="content-row container d-flex flex-column flex-xl-row-reverse">
        {% if nav_type != 'minimal' %}
            <nav class="footer-menu">
                <ul class="list-unstyled">
                    {% for primary in footer_primary_menu %}
                        <li>
                            <a
                                href="{{ primary.url }}"
                                data-ga-category="Footer Navigation"
                                data-ga-action="Footer Links"
                                data-ga-label="{{ primary.title }}"
                                {% if ( primary.target is same as '_blank' ) %}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                {% endif %}
                            >
                                {{ primary.title|e('wp_kses_post')|raw }}
                            </a>
                        </li>
                    {% endfor %}

                    {% for secondary in footer_secondary_menu %}
                        <li>
                            <a
                                href="{{ secondary.url }}"
                                data-ga-category="Footer Navigation"
                                data-ga-action="Footer Links"
                                data-ga-label="{{ secondary.title }}"
                                {% if ( secondary.target is same as '_blank' ) %}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                {% endif %}
                            >
                                {{ secondary.title|e('wp_kses_post')|raw }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
            <div class="company-message">
            {% include 'footer_acknowledgement_of_country.twig' %}
            {% include 'footer_commitment_to_diversity.twig' %}
            </div>
        {% endif %}
        {% include 'footer_info.twig' %}
    </div>

    <div class="copyright">
        <div class="container d-flex flex-column flex-xl-row">
            <span role="text">
                {{ 'creative-commons'|svgicon }}
                {{ copyright_text_line2|e('wp_kses_post')|raw }} {{"now"|date('Y')}}
            </span>
            <span role="text">
                {{ copyright_text_line1|e('wp_kses_post')|raw }}
            </span>
        </div>
    </div>
</footer>
{% endif %}
